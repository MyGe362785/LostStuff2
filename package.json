{
  "name": "loststuff2-university-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:security:integration": "node scripts/supabase-security-integration.mjs",
    "security:dependencies": "npm audit --audit-level=high",
    "security:secrets": "node scripts/check-secrets.mjs",
    "security:check": "npm run security:secrets && npm run security:dependencies && npm test"
  },
  "dependencies": {
    "@fontsource/kanit": "^5.3.0",
    "@supabase/supabase-js": "^2.116.0",
    "lucide-vue-next": "^0.468.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
